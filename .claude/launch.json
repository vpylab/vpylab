{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "vpylab-client",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 4033,
      "cwd": "client"
    },
    {
      "name": "vpylab-pages-dev",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "wrangler",
        "pages",
        "dev",
        "client/dist",
        "--port",
        "4086",
        "--persist-to",
        "/private/tmp/vpylab-pages-dev-state"
      ],
      "port": 4086
    }
  ]
}
