# VPyLab 빌드 설정 예시. 모두 공개해도 되는 값이며, 하나도 넣지 않아도 실행·내려받기·파일 열기는 동작합니다.
# 로컬에서 시험할 때는 이 파일을 client/.env.local로 복사해 값을 넣습니다(.env.local은 커밋되지 않습니다).
# 운영 배포의 값은 저장소의 Actions 변수에 있습니다(.github/workflows/deploy-pages.yml, docs/DEPLOY.md).

# 구글 드라이브 저장: 구글 OAuth 클라이언트 ID(웹 애플리케이션). 없으면 "저장"과 "내 드라이브"가 꺼집니다.
VITE_GOOGLE_CLIENT_ID=

# GitHub 팀 프로젝트: GitHub OAuth 앱의 클라이언트 ID. 없으면 "팀 프로젝트"가 꺼집니다.
# 클라이언트 비밀값은 여기에 넣지 않습니다. Cloudflare Pages의 비밀값(GITHUB_CLIENT_SECRET)이나 로컬의 .dev.vars에 둡니다.
VITE_GITHUB_CLIENT_ID=

# 학생 작품 갤러리와 대장간 모두의 모듈: 목록 파일의 주소. 없으면 두 기능이 꺼집니다.
# 예: https://raw.githubusercontent.com/vpylab/vpylab/gallery-data/gallery.json
VITE_GALLERY_INDEX_URL=
# 예: https://raw.githubusercontent.com/vpylab/vpylab/gallery-data/forge.json
VITE_FORGE_INDEX_URL=
