{
  "name": "client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:teacher-training": "vite build --config vite.training.config.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "dev:classroom": "vite --config vite.classroom.config.js",
    "build:classroom": "vite build --config vite.classroom.config.js",
    "dev:drive-lab": "vite --config vite.drivelab.config.js",
    "build:drive-lab": "vite build --config vite.drivelab.config.js",
    "build:deploy": "vite build && vite build --config vite.drivelab.config.js --outDir dist --emptyOutDir false",
    "preview:deploy": "vite preview --config vite.drivelab.config.js --outDir dist",
    "build:open": "VITE_EDITION=open VITE_SUPABASE_URL= VITE_SUPABASE_ANON_KEY= VITE_API_URL= npm run build:deploy && node scripts/cloudflare-pages.mjs dist --edition open"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.0",
    "@supabase/supabase-js": "^2.103.0",
    "lz-string": "^1.5.0",
    "monaco-editor": "0.55.1",
    "nanoid": "^5.1.7",
    "pyodide": "0.27.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.14.1",
    "three": "^0.183.2",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.0.2",
    "tailwindcss": "^4.2.2",
    "vite": "^8.0.4",
    "vitest": "^4.1.4"
  }
}
