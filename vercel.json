{
  "framework": null,
  "installCommand": "",
  "buildCommand": "mkdir -p .vercel-redirect && echo 'VPyLab moved to https://vpylab.pages.dev' > .vercel-redirect/index.html",
  "outputDirectory": ".vercel-redirect",
  "redirects": [
    {
      "source": "/:path*",
      "destination": "https://vpylab.pages.dev/:path*",
      "permanent": false
    }
  ]
}
